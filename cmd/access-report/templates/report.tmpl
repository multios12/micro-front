                          <td class="numeric">{{number .Count}}</td>
                        </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                    </table>
                  </div>
                  {{if .CrawlerMore}}<details class="security-more">
                    <summary>21件目以降を表示（残り{{number (len .CrawlerMore)}}件）</summary>
                    <div class="table-scroll security-table">
                      <table>
                        <thead>
                          <tr>
                            <th scope="col">クローラー名 / User-Agent</th>
                            <th scope="col" class="numeric">アクセス数</th>
                          </tr>
                        </thead>
                        <tbody>{{range .CrawlerMore}}<tr>
                            <th scope="row"><span class="article-label">{{.Name}}</span><span class="path">{{.Label}}</span></th>
                            <td class="numeric">{{number .Count}}</td>
                          </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                      </table>
                    </div>
                  </details>{{end}}
                  <p class="sub" style="margin-top: 16px">判定ルール：{{$.RulesLabel}}</p>
                </section>
<section class="content panel">
  <div class="section-head"><h2>脆弱性スキャンの疑い</h2><p>{{number .ScanCount}}アクセス元 · IP単位の推定</p></div>
  <p class="sub" style="margin-bottom: 16px">1日{{number $.ScanMin404}}件以上の404、かつ{{number $.ScanMinPaths}}種類以上のパス。件数・観測日時は選択期間内の404を集計（{{$.Timezone}}）。</p>
  {{template "scan-table" .ScanTop}}
  {{if .ScanMore}}<details class="security-more"><summary>21件目以降を表示（残り{{number (len .ScanMore)}}アクセス元）</summary>{{template "scan-table" .ScanMore}}</details>{{end}}
</section>

                <section class="content panel">
                  <div class="section-head">
                    <h2>404ページの一覧</h2>
                    <p>クエリ文字列を除いて集約 · アクセス数の多い順</p>
                  </div>
                  <div class="table-scroll security-table">
                    <table>
                      <thead>
                        <tr>
                          <th scope="col">リクエストパス</th>
                          <th scope="col" class="numeric">アクセス数</th>
                        </tr>
                      </thead>
                      <tbody>{{range .NotFoundTop}}<tr>
                          <th scope="row">{{.Label}}</th>
                          <td class="numeric">{{number .Count}}</td>
                        </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                    </table>
                  </div>
                  {{if .NotFoundMore}}<details class="security-more">
                    <summary>21件目以降を表示（残り{{number (len .NotFoundMore)}}件）</summary>
                    <div class="table-scroll security-table">
                      <table>
                        <thead>
                          <tr>
                            <th scope="col">リクエストパス</th>
                            <th scope="col" class="numeric">アクセス数</th>
                          </tr>
                        </thead>
                        <tbody>{{range .NotFoundMore}}<tr>
                            <th scope="row">{{.Label}}</th>
                            <td class="numeric">{{number .Count}}</td>
                          </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                      </table>
                    </div>
                  </details>{{end}}
                </section>
              </div>{{end}}
            </fieldset>
          </div>
        </fieldset>
        <footer class="footer"><span>micro-front / access-report</span></footer>
      </main>
    </div>
  </body>
</html>

{{define "scan-table"}}
<div class="table-scroll"><table>
  <thead><tr><th scope="col">アクセス元 / 対象パス・UA</th><th scope="col" class="numeric">期間内404</th><th scope="col" class="numeric">検出日数</th><th scope="col">観測日時</th></tr></thead>
  <tbody>{{range .}}<tr>
    <th scope="row" style="overflow-wrap: anywhere"><span class="article-label">{{.IP}}</span>
      <details><summary>対象パス・User-Agent</summary>
        <p class="sub" style="margin-top: 12px">対象パス（上位5件）</p>
        {{range .Paths}}<p class="path">{{.Label}} · {{number .Count}}件</p>{{end}}
        <p class="sub" style="margin-top: 12px">User-Agent（上位5件）</p>
        {{range .Agents}}<p class="path">{{if .Name}}{{.Name}} · {{end}}{{.Label}} · {{number .Count}}件</p>{{end}}
      </details>
    </th>
    <td class="numeric"><strong>{{number .Count}}件</strong><br /><span class="sub">{{number .PathCount}}パス</span></td>
    <td class="numeric">{{number .DetectedDays}}日<br /><span class="sub">最多 {{number .Peak}}件 / 日</span></td>
    <td><span class="path">{{.First}}</span><br /><span class="sub">〜</span><br /><span class="path">{{.Last}}</span></td>
  </tr>{{else}}<tr><td colspan="4">条件に該当するアクセス元はありません。</td></tr>{{end}}</tbody>
</table></div>
{{end}}
