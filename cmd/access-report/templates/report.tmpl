                        </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                    </table>
                  </div>
                  {{if .NotFoundMore}}<details class="security-more">
                    <summary>21件目以降を表示（残り{{number (len .NotFoundMore)}}件）</summary>
                    <div class="table-scroll security-table">
                      <table>
                        <thead>
                          <tr>
                            <th scope="col">リクエストパス</th>
                            <th scope="col" class="numeric">アクセス数</th>
                          </tr>
                        </thead>
                        <tbody>{{range .NotFoundMore}}<tr>
                            <th scope="row">{{.Label}}</th>
                            <td class="numeric">{{number .Count}}</td>
                          </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                      </table>
                    </div>
                  </details>{{end}}
                </section>
              </div>{{end}}
              {{with .All}}<div
                class="security-period"
                id="security-all"
                role="region"
                aria-label="全期間のクローラー・404"
              >
                <section class="period panel">
                  <div>
