{{define "styles"}}
<style>
      :root {
        color-scheme: dark;
        --bg: #0b1020;
        --panel: rgba(15, 23, 42, 0.94);
        --text: #f1f5f9;
        --muted: #a5b4c8;
        --line: rgba(255, 255, 255, 0.1);
        --brand: #f59e0b;
        --soft: rgba(245, 158, 11, 0.12);
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: "Noto Sans JP", "Hiragino Sans", "Yu Gothic", sans-serif;
        color: var(--text);
        background:
          radial-gradient(
            circle at top left,
            rgba(245, 158, 11, 0.1),
            transparent 24%
          ),
          radial-gradient(
            circle at top right,
            rgba(59, 130, 246, 0.1),
            transparent 28%
          ),
          linear-gradient(180deg, #0b1020, #0e1428 50%, #11182e);
        line-height: 1.65;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      a:focus-visible,
      summary:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 5px;
      }
      .shell {
        width: min(1440px, calc(100% - 32px));
        margin: 0 auto;
        padding: 16px 0 28px;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
      }
      .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 24px;
        box-shadow: 0 24px 64px #00000036;
      }
      .muted,
      .sub {
        color: var(--muted);
      }
      .sub {
        font-size: 12px;
      }
      .main {
        min-width: 0;
        display: grid;
        gap: 16px;
        align-content: start;
      }
      .topbar {
        padding: 22px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      h1,
      h2,
      p {
        margin: 0;
      }
      h1 {
        font-size: 24px;
        line-height: 1.4;
      }
      h2 {
        font-size: 17px;
      }
      .eyebrow {
        font-size: 11px;
        letter-spacing: 0.13em;
        color: #fbbf24;
        margin-bottom: 6px;
        font-weight: 700;
      }
      .badge {
        display: inline-block;
        border: 1px solid #f59e0b40;
        background: var(--soft);
        color: #fcd34d;
        border-radius: 999px;
        padding: 5px 11px;
        font-size: 12px;
        white-space: nowrap;
      }
      .period {
        padding: 20px 26px;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: center;
      }
      .period strong {
        display: block;
        font-size: 18px;
        margin-top: 3px;
      }
      .metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
      }
      .metric {
        padding: 22px 24px;
      }
      .metric .label {
        font-size: 13px;
        color: var(--muted);
      }
      .value {
        font-size: 36px;
        font-weight: 700;
        line-height: 1.3;
        margin: 10px 0 7px;
        font-variant-numeric: tabular-nums;
      }
      .value small {
        font-size: 14px;
        color: var(--muted);
        font-weight: 400;
        margin-left: 6px;
      }
      .metric:first-child .value {
        color: #fbbf24;
      }
      .content {
        padding: 24px 26px;
      }
      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 22px;
      }
      .section-head p {
        font-size: 12px;
        color: var(--muted);
      }
      .chart {
        display: flex;
        height: 172px;
        gap: 3px;
        border-bottom: 1px solid var(--line);
        padding: 0 0 0;
        align-items: stretch;
      }
      .day {
        flex: 1;
        min-width: 0;
        position: relative;
        display: flex;
        flex-direction: column;
      }
      .bar-area {
        height: 145px;
        display: flex;
        align-items: end;
      }
      .bar {
        display: block;
        width: 100%;
        min-width: 1px;
        background: linear-gradient(0deg, #b45309, #fbbf24);
        border-radius: 3px 3px 0 0;
        min-height: 0;
      }
      .tick {
        font-size: 10px;
        color: var(--muted);
        height: 26px;
        padding-top: 6px;
        white-space: nowrap;
      }
      .day:last-child .tick {
        align-self: flex-end;
      }
      .chart-note {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 12px;
        font-size: 12px;
        color: var(--muted);
      }
      .table-scroll {
        overflow-x: auto;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
      }
      caption {
        text-align: left;
        color: var(--muted);
        padding-bottom: 12px;
        font-size: 12px;
      }
      thead th {
        color: var(--muted);
        font-size: 11px;
        font-weight: 500;
        text-align: left;
        padding: 0 12px 13px;
        border-bottom: 1px solid var(--line);
      }
      tbody td,
      tbody th {
        padding: 15px 12px;
        border-bottom: 1px solid #ffffff09;
        text-align: left;
        font-weight: 400;
      }
      tbody tr:last-child td,
      tbody tr:last-child th {
        border-bottom: 0;
      }
      tbody tr:hover {
        background: #ffffff03;
      }
      .rank {
        color: var(--muted);
        width: 46px;
        font-variant-numeric: tabular-nums;
      }
      .article-label {
        display: block;
        font-weight: 600;
      }
      .path {
        font-family: Consolas, monospace;
        color: var(--muted);
        font-size: 12px;
      }
      .numeric {
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .share {
        width: 25%;
        min-width: 105px;
        font-variant-numeric: tabular-nums;
        color: var(--muted);
      }
      .track {
        display: block;
        height: 4px;
        background: #ffffff0a;
        border-radius: 4px;
        margin-top: 8px;
      }
      .track > span {
        display: block;
        height: 100%;
        background: var(--brand);
        border-radius: 4px;
      }
      .conditions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
      }
      .conditions dl {
        margin: 0;
        display: grid;
        grid-template-columns: 100px 1fr;
        gap: 9px;
        font-size: 13px;
      }
      .conditions dt {
        color: var(--muted);
      }
      .conditions dd {
        margin: 0;
        overflow-wrap: anywhere;
      }
      .note-box {
        padding: 16px;
        background: #ffffff03;
        border: 1px solid var(--line);
        border-radius: 14px;
        font-size: 12px;
        color: var(--muted);
      }
      .note-box strong {
        display: block;
        color: var(--text);
        margin-bottom: 6px;
      }
      details {
        margin-top: 20px;
        border-top: 1px solid var(--line);
        padding-top: 14px;
      }
      summary {
        cursor: pointer;
        color: var(--muted);
        font-size: 12px;
      }
      .daily-table {
        max-height: 320px;
        overflow: auto;
        margin-top: 16px;
      }
      .footer {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 4px 8px;
        font-size: 11px;
        color: var(--muted);
      }
      @media (max-width: 1050px) {
        .shell {
          grid-template-columns: 1fr;
        }
        .conditions {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 600px) {
        .shell {
          width: calc(100% - 24px);
          padding-top: 12px;
          gap: 12px;
        }
        .main {
          gap: 12px;
        }
        .metrics {
          grid-template-columns: 1fr;
          gap: 10px;
        }
        .metric {
          padding: 16px 20px;
          display: grid;
          grid-template-columns: 1fr auto;
          align-items: center;
          column-gap: 10px;
        }
        .metric .sub {
          grid-column: 1 / -1;
        }
        .value {
          font-size: 28px;
          margin: 0;
        }
        .content,
        .topbar,
        .period {
          padding: 20px;
        }
        .topbar,
        .period {
          align-items: flex-start;
          flex-direction: column;
        }
        h1 {
          font-size: 22px;
        }
        .period strong {
          font-size: 16px;
        }
        .section-head {
          align-items: flex-start;
          flex-direction: column;
          gap: 5px;
        }
        .chart {
          gap: 2px;
        }
        .chart-note,
        .footer {
          flex-direction: column;
          gap: 4px;
        }
        .conditions dl {
          grid-template-columns: 82px 1fr;
        }
        .share {
          min-width: 82px;
        }
        .table-scroll table {
          min-width: 440px;
        }
      }
      @media print {
        body {
          background: white;
          color: black;
        }
        .shell {
          display: block;
          width: 100%;
        }
        .panel {
          box-shadow: none;
          background: white;
          border-color: #ddd;
          break-inside: avoid;
          margin-bottom: 16px;
        }
        .muted,
        .sub,
        .label,
        .path,
        .rank,
        .share,
        thead th,
        .chart-note,
        .footer,
        .conditions dt {
          color: #555 !important;
        }
        .note-box {
          background: white;
          color: #555;
        }
        .badge {
          color: #92400e;
        }
        .value {
          color: #92400e !important;
        }
        .table-scroll {
          overflow: visible;
        }
      }
      .report-tabs {
        border: 0;
        padding: 0;
        margin: 0;
        min-width: 0;
      }
      .report-tabs > label {
        display: inline-block;
        padding: 9px 20px;
        margin: 0 8px 18px 0;
        border: 1px solid var(--line);
        border-radius: 10px;
        color: var(--muted);
        cursor: pointer;
        font-size: 13px;
      }
      .report-tabs > label:hover {
        background: #ffffff08;
      }
      .ranking-choice,
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }
      .ranking-choice:checked + label {
        color: #fbbf24;
        border-color: #f59e0b55;
        background: var(--soft);
        font-weight: 600;
      }
      .ranking-choice:focus-visible + label {
        outline: 2px solid var(--brand);
        outline-offset: 3px;
      }
      .report-period {
        display: none;
        min-width: 0;
      }
      .ranking-period {
        font-size: 12px;
        color: var(--muted);
        margin: 0 0 14px;
      }
      #period-month:checked ~ #report-month,
      #period-all:checked ~ #report-all {
        display: grid;
        gap: 16px;
      }
      @media print {
        .report-period {
          display: grid !important;
        }
        .report-tabs > label {
          display: none;
        }
      }
      .ranking-more .table-scroll {
        margin-top: 16px;
      }
      .ranking-more summary {
        color: #fbbf24;
        font-size: 13px;
      }
      .ranking-more table {
        table-layout: fixed;
      }
      .ranking-more th:nth-child(1) {
        width: 46px;
      }
      .ranking-more th:nth-child(3) {
        width: 100px;
      }
      .ranking-more th:nth-child(4) {
        width: 25%;
      }
      @media print {
        .ranking-more {
          display: block;
        }
      }
      .bar-area {
        gap: 1px;
      }
      .bar-area > .bar {
        width: 50%;
      }
      .unique-bar {
        background: linear-gradient(0deg, #0f766e, #5eead4);
      }
      .legend-total:before,
      .legend-unique:before {
        content: "";
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        margin-right: 5px;
        background: #f59e0b;
      }
      .legend-unique:before {
        background: #5eead4;
      }
      .legend-unique {
        margin-left: 12px;
      }
      .table-scroll table {
        min-width: 620px;
      }
      .ranking-more th:nth-child(4) {
        width: 150px;
      }
      .ranking-more th:nth-child(5) {
        width: 22%;
      }
      @media (min-width: 601px) and (max-width: 1000px) {
        .metrics {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .view-tabs,
      .security-tabs {
        border: 0;
        padding: 0;
        margin: 0;
        min-width: 0;
      }
      .view-tabs > label,
      .security-tabs > label {
        display: inline-block;
        padding: 9px 20px;
        margin: 0 8px 18px 0;
        border: 1px solid var(--line);
        border-radius: 10px;
        color: var(--muted);
        cursor: pointer;
        font-size: 13px;
      }
      .view-tabs > label:hover,
      .security-tabs > label:hover {
        background: #ffffff08;
      }
      .view-tabs > .ranking-choice:checked + label,
      .security-tabs > .ranking-choice:checked + label {
        color: #fbbf24;
        border-color: #f59e0b55;
        background: var(--soft);
        font-weight: 600;
      }
      .view-panel,
      .security-period {
        display: none;
        min-width: 0;
      }
      #view-choice-access:checked ~ #view-access,
      #view-choice-security:checked ~ #view-security {
        display: block;
      }
      #security-choice-month:checked ~ #security-month,
      #security-choice-all:checked ~ #security-all {
        display: grid;
        gap: 16px;
      }
      .security-metrics {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }
      .security-table table {
        table-layout: fixed;
        min-width: 0;
      }
      .security-table th:first-child {
        width: 80%;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .security-table th:last-child {
        width: 20%;
      }
      .security-table tbody th {
        font-family: Consolas, monospace;
        font-size: 12px;
      }
      .security-more summary {
        color: #fbbf24;
        font-size: 13px;
      }
      .security-more .table-scroll {
        margin-top: 16px;
        max-height: 560px;
        overflow: auto;
      }
      @media (max-width: 600px) {
        .security-metrics {
          grid-template-columns: 1fr;
        }
        .security-table th:first-child {
          width: 70%;
        }
        .security-table th:last-child {
          width: 30%;
        }
        .view-tabs > label,
        .security-tabs > label {
          padding: 9px 13px;
        }
      }
      @media print {
        .view-panel,
        .security-period {
          display: block !important;
        }
        .view-tabs > label,
        .security-tabs > label {
          display: none;
        }
      }
    </style>
{{end}}
