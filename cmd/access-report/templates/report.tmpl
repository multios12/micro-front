                      <span class="legend-unique">ユニークアクセス数</span>
                    </span>
                    <span>最多 {{number .Peak}}件 / 日</span>
                  </div>
                  <details>
                    <summary>日別データを表で確認</summary>
                    <div class="daily-table">
                      <table>
                        <caption>0件の日を含む全{{.DayCount}}日</caption>
                        <thead>
                          <tr>
                            <th scope="col">日付（{{$.Timezone}}）</th>
                            <th scope="col" class="numeric">アクセス数</th>
                            <th scope="col" class="numeric">
                              ユニークアクセス数
                            </th>
                          </tr>
                        </thead>
                        <tbody>{{range .Days}}<tr>
                            <th scope="row">{{.Day}}</th>
                            <td class="numeric">{{number .Accesses}}</td>
                            <td class="numeric">{{number .Unique}}</td>
                          </tr>{{else}}<tr><td colspan="3">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                      </table>
                    </div>
                  </details>
                </section>
                <section class="content panel">
                  <div class="section-head">
                    <h2>記事ランキング</h2>
                    <p>アクセス数の多い順 · 全{{.ArticleCount}}記事</p>
                  </div>
                  <div class="table-scroll">
                    <table>
                      <caption>
                        記事タイトルと公開パスを表示しています。
                      </caption>
                      <thead>
                        <tr>
                          <th scope="col">順位</th>
                          <th scope="col">記事</th>
                          <th scope="col" class="numeric">アクセス数</th>
                          <th scope="col" class="numeric">
                            ユニークアクセス数
                          </th>
                          <th scope="col">期間内に占める割合</th>
                        </tr>
                      </thead>
                      <tbody>{{range .Top}}<tr>
                          <td class="rank">{{printf "%02d" .Rank}}</td>
                          <th scope="row">
                            <span class="article-label">{{.Title}}</span>
                            <span class="path">{{.Path}}</span>
                          </th>
                          <td class="numeric"><strong>{{number .Accesses}}</strong></td>
                          <td class="numeric">{{number .Unique}}</td>
                          <td class="share">
                            <span>{{printf "%.1f" .Share}}%</span>
                            <span class="track">
                              <span style="width: {{printf "%.1f" .Share}}%"></span>
                            </span>
                          </td>
                        </tr>{{else}}<tr><td colspan="5">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                    </table>
                  </div>
                  {{if .More}}<details class="ranking-more">
                    <summary>21位以降を表示（残り{{number (len .More)}}記事）</summary>
                    <div class="table-scroll">
                      <table>
                        <caption class="visually-hidden">
                          記事ランキングの21位以降
                        </caption>
                        <thead>
                          <tr>
                            <th scope="col">順位</th>
                            <th scope="col">記事</th>
                            <th scope="col" class="numeric">アクセス数</th>
                            <th scope="col" class="numeric">
                              ユニークアクセス数
                            </th>
                            <th scope="col">期間内に占める割合</th>
                          </tr>
                        </thead>
                        <tbody>{{range .More}}<tr>
                            <td class="rank">{{printf "%02d" .Rank}}</td>
                            <th scope="row">
                              <span class="article-label">{{.Title}}</span>
                              <span class="path">{{.Path}}</span>
                            </th>
                            <td class="numeric"><strong>{{number .Accesses}}</strong></td>
                            <td class="numeric">{{number .Unique}}</td>
                            <td class="share">
                              <span>{{printf "%.1f" .Share}}%</span>
                              <span class="track">
                                <span style="width: {{printf "%.1f" .Share}}%"></span>
                              </span>
                            </td>
                          </tr>{{else}}<tr><td colspan="5">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                      </table>
                    </div>
                  </details>{{end}}
                </section>
              </div>{{end}}
            </fieldset>
          </div>
          <div
            class="view-panel"
            id="view-security"
            role="region"
            aria-label="クローラー・404"
          >
            <fieldset class="security-tabs">
              <legend class="visually-hidden">クローラー・404の表示期間</legend>
              <input
                class="ranking-choice"
                type="radio"
                name="security-period"
                id="security-choice-month"
                aria-controls="security-month"
                checked
              />
              <label for="security-choice-month">過去1か月</label>
              <input
                class="ranking-choice"
                type="radio"
                name="security-period"
                id="security-choice-all"
                aria-controls="security-all"
              />
              <label for="security-choice-all">全期間</label>
              {{with .Month}}<div
                class="security-period"
                id="security-month"
                role="region"
                aria-label="過去1か月のクローラー・404"
              >
                <section class="period panel">
                  <div>
                    <span class="sub">集計期間</span>
                    <strong>{{.From}} <span class="muted">—</span> {{.To}}</strong>
                  </div>
                  <div class="sub">{{$.Host}}<br />{{$.Timezone}}</div>
                </section>
                <div class="security-metrics">
                  <section class="metric panel">
                    <h2 class="label">クローラーによるアクセス</h2>
                    <div class="value">{{number .CrawlerTotal}} <small>件</small>
                    </div>
                    <p class="sub">User-Agent {{number .CrawlerCount}}種類 · 全パス・全ステータス</p>
                  </section>
                  <section class="metric panel">
                    <h2 class="label">404レスポンス</h2>
                    <div class="value">{{number .NotFoundTotal}} <small>件</small>
                    </div>
                    <p class="sub">{{number .NotFoundCount}}パス · 全メソッド</p>
                  </section>
                </div>
                <section class="content panel">
                  <div class="section-head">
                    <h2>クローラーによるアクセス</h2>
                    <p>User-Agentによる推定 · アクセス数の多い順</p>
                  </div>
                  <div class="table-scroll security-table">
                    <table>
                      <thead>
                        <tr>
                          <th scope="col">クローラー名 / User-Agent</th>
                          <th scope="col" class="numeric">アクセス数</th>
                        </tr>
                      </thead>
                      <tbody>{{range .CrawlerTop}}<tr>
                          <th scope="row"><span class="article-label">{{.Name}}</span><span class="path">{{.Label}}</span></th>
                          <td class="numeric">{{number .Count}}</td>
                        </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                    </table>
                  </div>
                  {{if .CrawlerMore}}<details class="security-more">
                    <summary>21件目以降を表示（残り{{number (len .CrawlerMore)}}件）</summary>
                    <div class="table-scroll security-table">
                      <table>
                        <thead>
                          <tr>
                            <th scope="col">クローラー名 / User-Agent</th>
                            <th scope="col" class="numeric">アクセス数</th>
                          </tr>
                        </thead>
                        <tbody>{{range .CrawlerMore}}<tr>
                            <th scope="row"><span class="article-label">{{.Name}}</span><span class="path">{{.Label}}</span></th>
                            <td class="numeric">{{number .Count}}</td>
                          </tr>{{else}}<tr><td colspan="2">該当するアクセスはありません。</td></tr>{{end}}</tbody>
                      </table>
                    </div>
                  </details>{{end}}
                  <p class="sub" style="margin-top: 16px">判定ルール：{{$.RulesLabel}}</p>
                </section>
<section class="content panel">
  <div class="section-head"><h2>脆弱性スキャンの疑い</h2><p>{{number .ScanCount}}アクセス元 · IP単位の推定</p></div>
  <p class="sub" style="margin-bottom: 16px">1日{{number $.ScanMin404}}件以上の404、かつ{{number $.ScanMinPaths}}種類以上のパス。件数・観測日時は選択期間内の404を集計（{{$.Timezone}}）。</p>
  {{template "scan-table" .ScanTop}}
  {{if .ScanMore}}<details class="security-more"><summary>21件目以降を表示（残り{{number (len .ScanMore)}}アクセス元）</summary>{{template "scan-table" .ScanMore}}</details>{{end}}
</section>

                <section class="content panel">
                  <div class="section-head">
                    <h2>404ページの一覧</h2>
                    <p>クエリ文字列を除いて集約 · アクセス数の多い順</p>
                  </div>
                  <div class="table-scroll security-table">
                    <table>
                      <thead>
                        <tr>
                          <th scope="col">リクエストパス</th>
